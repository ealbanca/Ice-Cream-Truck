{{define "content"}}

<div class="Management-Container">
    <h1>Welcome, {{.User.Name}}!</h1>
</div>

<div class="Account-Management">
    <h2>Account Management</h2>

    <table class="management-table">
        <tr>
            <td><a href="/edit-account">Edit Profile</a></td>
            <td>Update your personal information and preferences.</td>
        </tr>
        <tr>
            <td><a href="/account/orders">View Orders</a></td>
            <td>Review your past and current orders.</td>
        </tr>
        <tr>
            <td><a href="/account/creations">Your Creations</a></td>
            <td>Manage your custom ice cream creations.</td>
        </tr>
        <tr>
            <td><a href="/account/delete">Delete Account</a></td>
            <td>Remove your account permanently.</td>
        </tr>
    </table>
</div>

{{end}}