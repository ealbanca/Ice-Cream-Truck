{{define "content"}}
<h1>Your Cart</h1>

{{if .Message}}
	<div id="flash-message" class="{{.MessageType}}">{{.Message}}</div>
{{end}}

{{if .CartItems}}
<div class="cart-container">
   <table class="cart-table">
       <thead>
           <tr>
               <th>Product</th>
               <th>Size</th>
               <th>Flavors</th>
               <th>Toppings</th>
               <th>Qty</th>
               <th>Price</th>
               <th>Remove</th>
           </tr>
       </thead>
       <tbody>
           {{range .CartItems}}
           <tr>
               <td>{{.ProductName}}</td>
               <td>{{.SizeLabel}}</td>
               <td>{{.FlavorLabels}}</td>
               <td>{{.ToppingLabels}}</td>
               <td>
                   <form action="/cart/update-qty" method="POST" style="display:inline;">
                       <input type="hidden" name="cart_item_id" value="{{.ID}}">
                       <input type="number" name="quantity" value="{{.Quantity}}" min="1" style="width:50px;">
                       <button type="submit" class="update-btn">Update</button>
                   </form>
               </td>
               <td>${{printf "%.2f" .TotalPrice}}</td>
               <td>
                   <form action="/cart/remove" method="POST" style="display:inline;">
                       <input type="hidden" name="cart_item_id" value="{{.ID}}">
                       <button type="submit" class="remove-btn">Remove</button>
                   </form>
               </td>
           </tr>
           {{end}}
       </tbody>
   </table>
   <div class="cart-total">
       <strong>Total: ${{printf "%.2f" .CartTotal}}</strong>
	   <button onclick="location.href='/checkout'" class="checkout-btn">Checkout</button>
   </div>
</div>
{{else if .GuestCartItems}}
<div class="cart-container">
   <table class="cart-table">
       <thead>
           <tr>
               <th>Product</th>
               <th>Size</th>
               <th>Flavors</th>
               <th>Toppings</th>
               <th>Qty</th>
               <th>Price</th>
               <th>Remove</th>
           </tr>
       </thead>
       <tbody>
           {{range .GuestCartItems}}
           <tr>
               <td>{{.ProductName}}</td>
               <td>{{.SizeLabel}}</td>
               <td>{{.FlavorLabels}}</td>
               <td>{{.ToppingLabels}}</td>
               <td>
                   <form action="/cart/update-qty" method="POST" style="display:inline;">
                       <input type="hidden" name="cart_item_id" value="{{.ID}}">
                       <input type="number" name="quantity" value="{{.Quantity}}" min="1" style="width:50px;">
                       <button type="submit" class="update-btn">Update</button>
                   </form>
               </td>
               <td>${{printf "%.2f" .TotalPrice}}</td>
               <td>
                   <form action="/cart/remove" method="POST" style="display:inline;">
                       <input type="hidden" name="cart_item_id" value="{{.ID}}">
                       <button type="submit" class="remove-btn">Remove</button>
                   </form>
               </td>
           </tr>
           {{end}}
       </tbody>
   </table>
   <div class="cart-total">
       <strong>Total: ${{printf "%.2f" .CartTotal}}</strong>
	   <button onclick="location.href='/checkout'" class="checkout-btn">Checkout</button>
   </div>
</div>
{{else}}
	<p>Your cart is empty.</p>
{{end}}
{{end}}
