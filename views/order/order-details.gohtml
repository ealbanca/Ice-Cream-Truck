{{define "content"}}

<div class="order-details-container">
    <h1>Order Details - Order #{{.Order.ID}}</h1>

    <p><strong>Date:</strong> {{.Order.Date}}</p>
    <p><strong>Total Price:</strong> ${{printf "%.2f" .Order.TotalPrice}}</p>
    <p><strong>Status:</strong> {{.Order.Status}}</p>

    <h2>Items</h2>
    <table class="order-items-table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Size</th>
                <th>Flavors</th>
                <th>Toppings</th>
                <th>Quantity</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            {{range .Items}}
            <tr>
                <td>{{.Name}}</td>
                <td>{{.Size}}</td>
                <td>{{.Flavors}}</td>
                <td>{{.Toppings}}</td>
                <td>{{.Quantity}}</td>
                <td>${{printf "%.2f" .Price}}</td>
            </tr>
            {{end}}
        </tbody>
    </table>
        <a href="/account/orders" class="back-link">Back to Orders</a>
</div>
{{end}}