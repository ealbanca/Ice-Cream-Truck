{{define "content"}}
<div class="orders-container">
        <h1>{{.Title}}</h1>

    {{if .Orders}}
    <table class="orders-table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>User</th>
                <th>Date</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            {{range .Orders}}
            <tr>
                <td>{{.ID}}</td>
                <td>{{if .UserID.Valid}}{{.UserID.Int64}}{{else}}Guest{{end}}</td>
                <td>{{.Date}}</td>
                <td>${{printf "%.2f" .TotalPrice}}</td>
                <td>{{.Status}}</td>
                                <td>
                                    {{if .UserID.Valid}}
                                        <a href="/order/{{.ID}}">View Details</a>
                                    {{else}}
                                        <span title="Guest order - no details">N/A</span>
                                    {{end}}
                                </td>
            </tr>
            {{end}}
        </tbody>
    </table>
    {{else}}
    <p>You have no orders yet.</p>
    {{end}}
</div>
{{end}}