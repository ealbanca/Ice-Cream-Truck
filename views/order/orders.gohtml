{{define "content"}}
<div class="orders-container">
    <h1>Your Orders</h1>

    {{if .Orders}}
    <table class="orders-table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            {{range .Orders}}
            <tr>
                <td>{{.ID}}</td>
                <td>{{.Date}}</td>
                <td>${{printf "%.2f" .TotalPrice}}</td>
                <td>{{.Status}}</td>
                <td><a href="/order/{{.ID}}">View Details</a></td>
            </tr>
            {{end}}
        </tbody>
    </table>
    {{else}}
    <p>You have no orders yet.</p>
    {{end}}
</div>
{{end}}