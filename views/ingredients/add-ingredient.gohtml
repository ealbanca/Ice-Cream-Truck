{{define "content"}}
<div class="add-ingredient">
    <h1>Add New Ingredient</h1>
    <form action="/ingredients/add" method="POST" class="add-ingredient-form">
        <select name="ingredient_type" id="ingredient_type" required onchange="togglePriceField()">
            <option value="" disabled selected>Select Ingredient Type</option>
            <option value="Flavor">Flavor</option>
            <option value="Topping">Topping</option>
        </select>

        <label for="name">Ingredient Name:</label>
        <input type="text" id="name" name="name" required>

        <div id="price-field" style="display:none;">
            <label for="additional_price">Additional Price:</label>
            <input type="number" step="0.01" id="additional_price" name="additional_price">
        </div>

        <label for="img">Image Path:</label>
        <input type="text" id="img" name="img" required>

        <button type="submit" class="submit-button">Add Ingredient</button>
    </form>
</div>
<script>
function togglePriceField() {
    var type = document.getElementById('ingredient_type').value;
    var priceField = document.getElementById('price-field');
    if (type === 'Topping') {
        priceField.style.display = '';
        document.getElementById('additional_price').required = true;
    } else {
        priceField.style.display = 'none';
        document.getElementById('additional_price').required = false;
    }
}
</script>
{{end}}