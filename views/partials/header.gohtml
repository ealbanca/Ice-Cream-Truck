{{define "header"}}
<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">
      <img src="/images/logoColor.png" alt="Ice Cream Icon" />
    </a>
  </span>
  <div id="tools">
    {{if .User}}
      <a title="Click to log out" href="/logout">Log Out</a>
    {{else}}
      <a title="Click to log in" href="/login">Log In</a>
    {{end}}
  </div>
</header>
{{end}}
