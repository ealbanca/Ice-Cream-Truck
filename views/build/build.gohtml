{{define "content"}}
<h1>Build Your Own Ice Cream</h1>

{{if .Message}}
    <div class="message">{{.Message}}</div>
{{end}}
<div class="build-container">
    <form action="/build" method="POST" class="build-form" id="build-form">
        <div class="build-options">
            <div class="build-choice-group">
                <label>Choose Size <span>*</span></label>
                <div class="build-choice-list" id="size-choices">
                    {{range .Sizes}}
                    <div class="build-choice" data-value="{{.ID}}" data-label="{{.Label}}">
                        <img src="{{.Img}}" alt="{{.Label}}">
                        <span>{{.Label}}<br><small>${{printf "%.2f" .Price}}</small></span>
                    </div>
                    {{end}}
                </div>
                <input type="hidden" name="size" id="size-input" required>
            </div>
            <div class="build-choice-group">
                <label>Choose Flavor <span>*</span></label>
                <div class="build-choice-list" id="flavor-choices">
                    {{range .Flavors}}
                    <div class="build-choice" data-value="{{.ID}}">
                        <img src="{{.Img}}" alt="{{.Name}}">
                        <span>{{.Name}}</span>
                        <input type="number" class="flavor-count" min="0" max="3" value="0" style="width:48px;margin-top:0.3em;" />
                    </div>
                    {{end}}
                </div>
                <input type="hidden" name="flavor" id="flavor-input" required>
                <div id="flavor-limit-msg" style="color:#d32f2f;font-size:0.95em;margin-top:0.3em;"></div>
            </div>
            <div class="build-choice-group">
                <label>Choose Toppings (up to 3)</label>
                <div class="build-choice-list" id="toppings-choices">
                    {{range .Toppings}}
                    <div class="build-choice" data-value="{{.ID}}">
                        <img src="{{.Img}}" alt="{{.Name}}">
                        <span>{{.Name}}<br><small>+${{printf "%.2f" .Price}}</small></span>
                        <input type="number" class="topping-count" min="0" max="3" value="0" style="width:48px;margin-top:0.3em;" />
                    </div>
                    {{end}}
                </div>
                <input type="hidden" name="toppings" id="toppings-input">
                <div id="topping-limit-msg" style="color:#d32f2f;font-size:0.95em;margin-top:0.3em;"></div>
            </div>
        </div>
        <button type="submit">Build Ice Cream</button>
    </form>
</div>
<script src="/js/build.js"></script>
{{end}}